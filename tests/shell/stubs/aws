#!/usr/bin/env bash
# Stub AWS CLI for the shell tests.
#
# Records every invocation to $STUB_LOG so tests can assert on the exact
# arguments, and serves SSM parameters out of $STUB_SSM_DIR.
set -uo pipefail

printf '%s\n' "aws $*" >> "$STUB_LOG"

service="${1:-}"; shift || true
action="${1:-}"; shift || true

# Named-argument helper: value_of --name -> the following argument.
value_of() {
  local want="$1"; shift
  while [ $# -gt 0 ]; do
    if [ "$1" = "$want" ]; then
      echo "${2:-}"
      return 0
    fi
    shift
  done
  return 1
}

case "$service:$action" in
  ssm:get-parameter)
    name=$(value_of --name "$@") || exit 1
    file="$STUB_SSM_DIR/$(echo "$name" | tr '/' '_')"
    if [ "${STUB_SSM_FAIL:-0}" = "1" ]; then
      echo "An error occurred (AccessDeniedException)" >&2
      exit 255
    fi
    if [ -f "$file" ]; then
      cat "$file"
    else
      # Matches the real CLI: a missing parameter is an error, not empty output.
      echo "An error occurred (ParameterNotFound)" >&2
      exit 254
    fi
    ;;

  ssm:send-command)
    echo '{"Command": {"CommandId": "stub"}}'
    ;;

  route53:change-resource-record-sets)
    if [ "${STUB_ROUTE53_FAIL:-0}" = "1" ]; then
      echo "An error occurred (AccessDenied)" >&2
      exit 255
    fi
    value_of --change-batch "$@" > "$STUB_DIR/route53-change-batch.json"
    value_of --hosted-zone-id "$@" > "$STUB_DIR/route53-zone-id"
    echo '{"ChangeInfo": {"Status": "PENDING"}}'
    ;;

  s3:cp)
    src="${1:-}"; dst="${2:-}"
    if [ "${STUB_S3_FAIL:-0}" = "1" ]; then
      echo "upload failed" >&2
      exit 1
    fi
    case "$dst" in
      s3://*)
        mkdir -p "$STUB_DIR/s3"
        # Record the key and keep the payload so size assertions are possible.
        printf '%s\n' "$dst" >> "$STUB_DIR/s3-uploads"
        cp "$src" "$STUB_DIR/s3/$(basename "$dst")"
        ;;
      *)
        # Download: serve from the fixture directory if present.
        fixture="$STUB_DIR/s3-objects/$(basename "$src")"
        [ -f "$fixture" ] || { echo "NoSuchKey" >&2; exit 1; }
        cp "$fixture" "$dst"
        ;;
    esac
    ;;

  ec2:*)
    echo '{}'
    ;;

  *)
    echo "stub aws: unhandled $service $action" >&2
    exit 64
    ;;
esac
