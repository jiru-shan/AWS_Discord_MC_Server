# Terraform
.terraform/
# .terraform.lock.hcl is deliberately NOT ignored. Committing it pins the
# provider versions, so a fresh clone resolves what was actually tested.
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Holds the Discord webhook URL, which is a credential. The glob covers the
# copies people make before editing -- terraform.tfvars.bak and friends carry
# the same secret. The example file is the one exception.
terraform.tfvars
terraform.tfvars.*
!terraform.tfvars.example
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
terraform/.build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# Minecraft artefacts that should never be committed
*.jar
world/
logs/
*.tar.gz

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
