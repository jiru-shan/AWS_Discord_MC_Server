#!/bin/bash
# Runs once, at the first boot of the instance, via cloud-init.
#
# Kept deliberately small: it writes just enough configuration to reach AWS,
# then hands over to bootstrap.sh from the payload Terraform uploaded. Keeping
# the real logic in a plain shell file, rather than in this template, means the
# shell is not competing with Terraform over interpolation syntax, and the
# script can be linted and read on its own.
#
# Note the layout this establishes: code lives on the root volume under
# /opt/minecraft, and the world lives on the separate data volume mounted at
# /srv/minecraft. They must not overlap, or mounting the data volume would hide
# the very scripts that mounted it.
#
# Output lands in /var/log/cloud-init-output.log.

set -euxo pipefail

# A non-zero exit anywhere in this script leaves an instance cloud-init will
# not retry and on which minecraft.service does not exist yet -- so the
# ExecStopPost that normally powers the box off never runs, and it bills
# indefinitely. The guard therefore covers the whole script, not just
# bootstrap.sh: a dnf mirror hiccup or an instance role that has not finished
# propagating is likelier than a bug in the bootstrap itself, and both land
# above it.
#
# notify.sh may not exist yet -- the payload download is one of the steps this
# catches -- and the webhook may not be readable until bootstrap.sh has fetched
# the configuration, so the message is best-effort. The power-off is not.
first_boot_failed() {
  status=$?
  [ "$status" -eq 0 ] && return 0

  if [ -x /opt/minecraft/payload/bin/notify.sh ]; then
    /opt/minecraft/payload/bin/notify.sh       "First boot failed (exit $status). The instance powers off in 30 minutes; run 'aws ssm start-session' and read /var/log/cloud-init-output.log to see why."       || true
  fi

  if [ "${shutdown_on_crash}" = "true" ]; then
    shutdown -h +30
  fi
}
trap first_boot_failed EXIT

mkdir -p /etc/minecraft

cat > /etc/minecraft/bootstrap.env <<'BOOTSTRAP_ENV'
${bootstrap_env}
BOOTSTRAP_ENV
chmod 0644 /etc/minecraft/bootstrap.env

# Amazon Linux 2023 ships the AWS CLI, but not always unzip.
dnf install -y unzip tar gzip

export AWS_DEFAULT_REGION="${region}"

work=$(mktemp -d)
aws s3 cp "s3://${payload_bucket}/${payload_key}" "$work/payload.zip"

mkdir -p /opt/minecraft/payload
unzip -qo "$work/payload.zip" -d /opt/minecraft/payload
chmod +x /opt/minecraft/payload/bin/*
rm -rf "$work"

# Failing here is handled by the EXIT trap above, which reports it and leaves a
# half hour window to connect with SSM and read this log before the instance
# stops itself.
bash /opt/minecraft/payload/bin/bootstrap.sh
