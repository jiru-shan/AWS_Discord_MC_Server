#!/usr/bin/env bash
# Small admin CLI for the instance. Reach it with:
#   aws ssm start-session --target <instance-id>
# then run `sudo mc <command>`.
set -euo pipefail
. "${INSTALL_DIR:-/opt/minecraft}/bin/common.sh"

usage() {
  cat <<'USAGE'
Usage: mc <command>

  status              service state, player-facing address and uptime
  address             the address players should connect to
  console <command>   send a command to the server console (e.g. mc console list)
  logs [-f]           show the server log, -f to follow
  backup              take a backup now (safe while the server is running)
  mods                list the installed mods
  mods sync           re-download the configured mods now
  version             the Minecraft version installed, and the one configured
  upgrade             install the configured minecraft_version now
  stop                save, back up and power the instance off
  maintenance-stop    stop the server but leave the instance running
  start               start the server
  update              re-download the payload Terraform uploaded
USAGE
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  status)
    systemctl status minecraft.service --no-pager || true
    echo
    echo "connect address: $(connect_address_with_port 2>/dev/null || echo 'unknown')"
    ;;
  address)
    connect_address_with_port
    ;;
  console)
    [ $# -gt 0 ] || die "usage: mc console <command>"
    [ -p "$RUN_DIR/console" ] || die "server is not running"
    echo "$*" > "$RUN_DIR/console"
    echo "sent: $*  (see the reply with: mc logs)"
    ;;
  logs)
    journalctl -u minecraft.service --no-pager -n 200 "$@"
    ;;
  backup)
    "$INSTALL_DIR/bin/backup.sh"
    ;;
  version)
    echo "installed:  $(installed_game_version 2>/dev/null || echo 'unrecorded')"
    echo "configured: ${MINECRAFT_VERSION:-latest}"
    ;;
  upgrade)
    # Forced, so it also covers the two cases the boot-time check declines:
    # minecraft_version = "latest", and a jar whose version was never recorded.
    [ "${1:-}" = "--yes" ] || {
      echo "This replaces the server jar and backs the world up first."
      echo "Worlds do not downgrade; the backup is the only way back."
      echo "Re-run as: mc upgrade --yes"
      exit 1
    }
    systemctl is-active --quiet minecraft.service       && die "stop the server first: mc maintenance-stop"
    FORCE_JAR_REINSTALL=true "$INSTALL_DIR/bin/update-server-jar.sh"
    ;;
  mods)
    # Takes effect on the next server start either way: Fabric reads the mods
    # directory once, at launch.
    case "${1:-list}" in
      list) node "$INSTALL_DIR/bin/install-mods.js" --list ;;
      sync) node "$INSTALL_DIR/bin/install-mods.js" ;;
      *)    die "usage: mc mods [list|sync]" ;;
    esac
    ;;
  stop)
    "$INSTALL_DIR/bin/request-stop.sh"
    ;;
  maintenance-stop)
    # No sentinel, so on-stop.sh backs up but leaves the instance running.
    rm -f "$RUN_DIR/idle-shutdown"
    systemctl stop minecraft.service
    echo "server stopped; the instance is still running"
    ;;
  start)
    systemctl start minecraft.service
    ;;
  update)
    "$INSTALL_DIR/bin/update-payload.sh"
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
