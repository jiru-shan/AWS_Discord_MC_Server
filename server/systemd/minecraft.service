[Unit]
Description=Minecraft on-demand server
Documentation=https://github.com/jiru-shan/AWS_Discord_MC_Server
After=network-online.target minecraft-refresh.service
Wants=network-online.target
# Pick up any configuration or script changes from the last `terraform apply`
# before starting. Wants, not Requires: a failed refresh must not stop the
# server from coming up with the configuration it already has.
Wants=minecraft-refresh.service
# The world lives on the data volume; do not start before it is mounted.
RequiresMountsFor=/srv/minecraft

[Service]
Type=simple
EnvironmentFile=/etc/minecraft/config.env

# Runs as root so that ExecStopPost can power the instance off without a
# sudoers rule. servermanager.js drops to MC_UID/MC_GID for the Java process
# itself, which is the part exposed to the internet.
ExecStartPre=/opt/minecraft/bin/announce-address.sh
# Seed ops.json / whitelist.json if they do not exist yet. Never overwrites,
# so in-game /op and /whitelist changes always win.
ExecStartPre=-/opt/minecraft/bin/seed-players.sh
# Raising data_volume_gb grows the EBS volume but not the filesystem on it, so
# the extra space would be invisible and the disk would fill anyway. xfs_growfs
# only ever grows, and does nothing when there is nothing to do.
ExecStartPre=-/usr/sbin/xfs_growfs /srv/minecraft
# Bring the jar in line with minecraft_version before the mods are resolved
# against it. Non-fatal: a failed update leaves the working jar in place.
ExecStartPre=-/opt/minecraft/bin/update-server-jar.sh
# Reconcile the mods directory with server_mods before the JVM reads it. The
# leading "-" makes a failure here non-fatal: mods are an optimisation, and no
# optimisation is worth leaving people unable to play.
ExecStartPre=-/usr/bin/node /opt/minecraft/bin/install-mods.js
ExecStart=/usr/bin/node /opt/minecraft/bin/servermanager.js
ExecStopPost=/opt/minecraft/bin/on-stop.sh

# Never restart: an exit here means the session is over and the box is on its
# way down. Restarting would fight the shutdown and keep the instance billing.
Restart=no

# Room for the mod sync above to fetch a few jars on a cold instance. The
# default 90 seconds is enough until someone lists a large modpack.
TimeoutStartSec=300

# Generous stop timeout: saving a large world can take a while, and being
# killed mid-save is how worlds get corrupted.
TimeoutStopSec=300
KillSignal=SIGTERM
KillMode=mixed

LimitNOFILE=1048576
StandardOutput=journal
StandardError=journal
SyslogIdentifier=minecraft

[Install]
WantedBy=multi-user.target
